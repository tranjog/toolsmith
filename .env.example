# Provider: ollama | openai
TOOLSMITH_PROVIDER=ollama

# Chat completions endpoint.
#   ollama native:  http://localhost:11434/api/chat
#   openai-compat:  http://localhost:11434/v1/chat/completions
#                   https://openrouter.ai/api/v1/chat/completions
TOOLSMITH_URL=http://localhost:11434/api/chat

# Model identifier (must exist on the provider)
TOOLSMITH_MODEL=lab/model:params

# Required for hosted openai-compatible providers
TOOLSMITH_API_KEY=

# Display name used in the chat prompt label
TOOLSMITH_AGENT_NAME=agent

# Log prompt/completion token counts per turn (true|false)
TOOLSMITH_LOG_TOKENS=false

# Tool exposure mode: static (all schemas wired up front) |
# progressive (inactive tools wired as stubs; full schema loads on
# first call and is returned inline if the first call fails)
TOOLSMITH_TOOL_DISCOVERY=static
